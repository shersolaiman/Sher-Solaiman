rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /siteSettings/{document} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'shersolaiman1@gmail.com';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
