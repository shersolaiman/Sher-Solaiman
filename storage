rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /docx-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'shersolaiman1@gmail.com'
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
